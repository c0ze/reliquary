# Reliquary configuration (copy to .env). All optional unless noted.

# --- Claude MCP endpoint (/claude/mcp) ---
# Bearer required for the Claude connector and OAuth. Generate a strong value,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
RELIQUARY_CLAUDE_MCP_TOKEN=

# --- OpenAI / ChatGPT MCP endpoint (/openai/mcp) ---
# Symmetric with the Claude endpoint: a valid token (this bearer or OAuth) is
# required for any access, and its scope decides read vs write. There is no
# anonymous access and no separate write flag.
RELIQUARY_OPENAI_MCP_TOKEN=

# --- OAuth shim (Claude.ai Custom Connector) ---
# After the connector registers once, pin its client id here and disable DCR.
RELIQUARY_OAUTH_CLIENT_ID=
RELIQUARY_OAUTH_ALLOW_REGISTRATION=true
# Return the master bearer verbatim instead of a derived, revocable token.
RELIQUARY_OAUTH_VERBATIM_TOKEN=false
# Token lifetimes (seconds). The access token is short-lived and silently renewed
# by a rotating, revocable refresh token. 0 = non-expiring refresh.
RELIQUARY_OAUTH_ACCESS_TOKEN_TTL=432000   # 5 days
RELIQUARY_OAUTH_REFRESH_TOKEN_TTL=0       # non-expiring
# Persist OAuth tokens + MCP sessions across restarts. STRONGLY RECOMMENDED:
# without it, every restart (e.g. a deploy) signs connectors out. The Docker
# Compose stack defaults this to /data/state (mounted from STATE_HOST_DIR below),
# so it only needs setting when running outside Docker or with a non-default
# container layout.
RELIQUARY_STATE_DIR=
# Docker Compose only: host directory bind-mounted to the container's state dir.
STATE_HOST_DIR=./data/state

# --- Retrieval routing ---
# Optional curated JSONL (or directory) enabling domain/hall/room/topic routing
# and fetch-by-id bootstrap documents. Mount it into the container and point here.
RELIQUARY_DATASET_PATH=

# --- Binary blobs (images, etc.) ---
# Docker Compose only: host directory bind-mounted to the container's blob dir.
# This is NOT read by the server — browse/back up this path on the host.
BLOB_HOST_DIR=./data/blobs
# Server: the in-container blob directory the server actually reads/writes.
# Defaults to /data/blobs (the compose mount target). Set this when running the
# server outside Docker, or with a non-default container layout.
RELIQUARY_BLOB_DIR=/data/blobs
# Max upload size in bytes (0 disables the cap). Default 30 MB.
RELIQUARY_BLOB_MAX_BYTES=31457280
# HMAC key for signed blob URLs. Blank = random per-process key (URLs break on
# restart); set a fixed value for stable, shareable URLs.
RELIQUARY_BLOB_SIGNING_KEY=
# Signed blob URL lifetime in seconds.
RELIQUARY_BLOB_URL_TTL=3600

# --- Public base URL ---
# Optional prefix applied to all blob and upload URLs returned by the server,
# e.g. https://r.example.com. Unset = relative paths (default; back-compatible).
# Set this when the server sits behind a reverse-proxy or is accessed remotely.
RELIQUARY_PUBLIC_BASE_URL=

# --- Compiled synthesis layer ---
# Qdrant collection for versioned synthesis pages. Set to empty to disable the
# compiled layer entirely (useful for lightweight / read-only deployments).
RELIQUARY_COMPILED_COLLECTION=reliquary_compiled
# Docker Compose only: host directory bind-mounted to the container's compiled dir.
COMPILED_HOST_DIR=./data/compiled
# Server: in-container path for the page registry and vault export.
# RELIQUARY_COMPILED_DIR=/data/compiled
# Path to an editable memory constitution file (reliquary://schema). Leave unset to
# use the built-in default constitution.
RELIQUARY_SCHEMA_PATH=
# Minimum number of raw corpus records in a domain/topic with no synthesis page
# before the lint pass flags a coverage gap. Default 8.
RELIQUARY_LINT_COVERAGE_MIN=8
