# Reliquary configuration (copy to .env). All optional unless noted.
# Keep comments on their own lines: `docker run --env-file` and systemd's
# EnvironmentFile treat anything after `=` as the value, including "# ...".
# A blank integer value means "use the default".

# --- Claude MCP endpoint (/claude/mcp) ---
# Bearer required for the Claude connector and OAuth. Generate a strong value,
# e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
RELIQUARY_CLAUDE_MCP_TOKEN=

# --- OpenAI / ChatGPT MCP endpoint (/openai/mcp) ---
# Symmetric with the Claude endpoint: a valid token (this bearer or OAuth) is
# required for any access, and its scope decides read vs write. There is no
# anonymous access and no separate write flag.
RELIQUARY_OPENAI_MCP_TOKEN=

# Endpoint paths (defaults shown).
# RELIQUARY_CLAUDE_MCP_PATH=/claude/mcp
# RELIQUARY_OPENAI_MCP_PATH=/openai/mcp

# Extra named bearer tokens besides the master token, each with its own scope:
# 'label:scope:token' entries separated by ';'. scope is read or write (anything
# other than read grants write). Example: readonly:read:abc123;editor:write:def456
# RELIQUARY_STATIC_TOKENS=

# Mem0 user id that searches and writes use. Imports must use the same id
# (app/ingest.py reads this variable too), or the records are invisible.
# RELIQUARY_USER_ID=default

# --- OAuth shim (Claude.ai Custom Connector) ---
# After the connector registers once, pin its client id here and disable DCR.
RELIQUARY_OAUTH_CLIENT_ID=
RELIQUARY_OAUTH_ALLOW_REGISTRATION=true
# Return the master bearer verbatim instead of a derived, revocable token.
RELIQUARY_OAUTH_VERBATIM_TOKEN=false
# Token lifetimes (seconds). The access token is short-lived and silently renewed
# by a rotating, revocable refresh token. 0 = non-expiring refresh.
# Access token: 432000 s = 5 days.
RELIQUARY_OAUTH_ACCESS_TOKEN_TTL=432000
# Refresh token: 0 = non-expiring.
RELIQUARY_OAUTH_REFRESH_TOKEN_TTL=0
# Persist OAuth tokens + MCP sessions across restarts. STRONGLY RECOMMENDED:
# without it, every restart (e.g. a deploy) signs connectors out. The Docker
# Compose stack defaults this to /data/state (mounted from STATE_HOST_DIR below),
# so it only needs setting when running outside Docker or with a non-default
# container layout.
RELIQUARY_STATE_DIR=
# Docker Compose only: host directory bind-mounted to the container's state dir.
# Like the blob and compiled dirs below it must be owned by uid 100 / gid 101
# (the image's user): sudo chown -R 100:101 data
STATE_HOST_DIR=./data/state

# --- Abuse limits and observability ---
# Max write tool calls (add/update/delete) per token per minute. 0 = unlimited.
RELIQUARY_RATE_LIMIT_WRITES=0
# Max search/fetch tool calls per token per minute. 0 = unlimited.
RELIQUARY_RATE_LIMIT_SEARCHES=0
# Append one JSONL line per write (add/update/delete) to this path. Unset = off.
# RELIQUARY_AUDIT_LOG=/data/state/audit.jsonl
# Serve GET /metrics without auth (default false: it needs the Claude bearer).
RELIQUARY_METRICS_PUBLIC=false

# --- Retrieval routing ---
# Optional curated JSONL (or directory) enabling domain/hall/room/topic routing
# and fetch-by-id bootstrap documents. Docker Compose mounts CORPUS_HOST_DIR
# read-only at /corpus, so e.g. RELIQUARY_DATASET_PATH=/corpus/corpus.jsonl
RELIQUARY_DATASET_PATH=
# Docker Compose only: host directory mounted read-only at /corpus.
CORPUS_HOST_DIR=./corpus

# Opt-in native hybrid search (mem0's server-side Qdrant BM25 re-rank). auto
# (default) detects a bm25-enabled collection + fastembed and skips the
# get_all lexical scan for ordinary queries; on assumes it's active; off
# always uses the scan. Requires `pip install -r requirements-hybrid.txt` and
# a fresh Qdrant collection — see docs/GUIDE.md ("Native hybrid search").
RELIQUARY_NATIVE_HYBRID=auto
# Allow concurrent memory reads (true/false). Unset = auto: concurrent for a
# Qdrant server, exclusive for embedded/local Qdrant (not read-thread-safe).
# Leave it commented out for auto; a blank value means false.
# RELIQUARY_MEMORY_CONCURRENT_READS=

# --- Embedder from the environment ---
# Used only when config.yaml has no `embedder` section (the example config has
# one). Provider is a Mem0 embedder name such as openai, ollama or lmstudio.
# RELIQUARY_EMBEDDER_PROVIDER=
# RELIQUARY_EMBEDDER_MODEL=
# RELIQUARY_EMBEDDER_BASE_URL=
# RELIQUARY_EMBEDDER_API_KEY=
# RELIQUARY_EMBEDDER_DIMS=768

# --- Mem0 telemetry ---
# Mem0 sends anonymous usage events to PostHog unless this is false. Reliquary
# defaults it to false; set true to opt in.
MEM0_TELEMETRY=false

# --- Binary blobs (images, etc.) ---
# Docker Compose only: host directory bind-mounted to the container's blob dir.
# This is NOT read by the server — browse/back up this path on the host.
BLOB_HOST_DIR=./data/blobs
# Server: the in-container blob directory the server actually reads/writes.
# Defaults to /data/blobs (the compose mount target). Set this when running the
# server outside Docker, or with a non-default container layout.
RELIQUARY_BLOB_DIR=/data/blobs
# Max upload size in bytes (0 disables the cap). Default 30 MB.
RELIQUARY_BLOB_MAX_BYTES=31457280
# HMAC key for signed blob URLs. Blank = random per-process key (URLs break on
# restart); set a fixed value for stable, shareable URLs.
RELIQUARY_BLOB_SIGNING_KEY=
# Signed blob URL lifetime in seconds.
RELIQUARY_BLOB_URL_TTL=3600
# add_image may fetch an image from a source_url server-side (default true).
# The fetch only reaches public addresses, but set false if the server should
# make no outbound requests on a caller's behalf. Blank also means false.
RELIQUARY_IMAGE_URL_INGEST=true

# --- Public base URL ---
# Optional prefix applied to all blob and upload URLs returned by the server,
# e.g. https://r.example.com. Unset = relative paths (default; back-compatible).
# Set this when the server sits behind a reverse-proxy or is accessed remotely.
RELIQUARY_PUBLIC_BASE_URL=

# --- Compiled synthesis layer ---
# Qdrant collection for versioned synthesis pages. Set to empty to disable the
# compiled layer entirely (useful for lightweight / read-only deployments).
RELIQUARY_COMPILED_COLLECTION=reliquary_compiled
# Docker Compose only: host directory bind-mounted to the container's compiled dir.
COMPILED_HOST_DIR=./data/compiled
# Server: in-container path for the page registry and vault export.
# RELIQUARY_COMPILED_DIR=/data/compiled
# Path to an editable memory constitution file (reliquary://schema). Leave unset to
# use the built-in default constitution.
RELIQUARY_SCHEMA_PATH=
# Minimum number of raw corpus records in a domain/topic with no synthesis page
# before the lint pass flags a coverage gap. Default 8.
RELIQUARY_LINT_COVERAGE_MIN=8
# Opt-in: path to an append-only JSONL retrieval-event log written by the server
# (one entry per search hit / fetch). Unset = disabled, zero overhead. When set,
# python app/lint.py aggregates it offline to propose never-retrieved records for
# archive and hot topics with no synthesis page for compilation.
RELIQUARY_RETRIEVAL_STATS_PATH=
# Minimum total retrieval events before lint proposes never-retrieved records for
# archive (guards against sparse-data false positives). Default 200.
# RELIQUARY_LINT_COLD_MIN_EVENTS=200

# --- Chat proxy write-back (only with --writeback, not used in MCP-only mode) ---
# Also append each written-back turn to this Markdown file (e.g. an Obsidian note).
# RELIQUARY_WRITEBACK_PATH=
